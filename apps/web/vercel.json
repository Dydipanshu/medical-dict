{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/download/windows",
      "destination": "https://github.com/Dydipanshu/usgscribe-desktop/releases/latest/download/USGScribe-Setup.exe",
      "permanent": false
    }
  ]
}